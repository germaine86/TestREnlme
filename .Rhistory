data=d
Expr   <- conc ~Dose * exp(ai2 + ai3 - ai1) * (exp(-Time * exp(ai3)) -  exp(-Time * exp(ai2)))/(exp(ai2) - exp(ai3))
start <- c(ai1 = -3.2, ai2 = 0.5, ai3 = -2.4)
random <- c("ai1 ~ B1 + bi1", "ai2 ~ B2 + bi2", "ai3 ~ B3 + bi3")
mb1   <- MM_base(d, Expr, group = "Subject", random = random, verbose = 1)
mb2   <- MM_base(d, Expr, group = "Subject", random = random,  verbose = 1, start = start)
mb1$start
mb2$start
DMM0  <- Dmethod(d, Expr, group = "Subject",  random = random, verbose = 0,  method = "MM");DMM0
DMM1  <- Dmethod(d, Expr, group = "Subject",  random = random, verbose = 0,  method = "MM",  MM_base_obj = mb1);DMM1
DMM2  <- Dmethod(d, Expr, group = "Subject",  random = random, verbose = 0,  method = "MM",  MM_base_obj = mb2);DMM2
########################################
Expr2   <- conc ~Dose * exp(ai2 + B3 - ai1) * (exp(-Time * exp(B3)) -  exp(-Time * exp(ai2)))/(exp(ai2) - exp(B3))
start2 <- c(ai1 = -3.22, ai2 = 0.47, B3 = -2.45)
random2 <- c("ai1 ~ B1 + bi1", "ai2 ~ B2 + bi2")
DVLS_C1 <- Dmethod(d, Expr2, group = "Subject", random = random2, method = "VLS", verbose = 1); DVLS_C1
DVLS_C2 <- Dmethod(d, Expr2, group = "Subject", random = random2, method = "VLS", start=start2,verbose = 1);DVLS_C2
DVLS_C1 <- Dmethod(d, Expr2, group = "Subject", random = random2, method = "VLS", verbose = 1); DVLS_C1
mb1   <- MM_base(d, Expr2, group = "Subject", random = random2, verbose = 1)
mb2   <- MM_base(d, Expr2, group = "Subject", random = random2,  verbose = 1, start = start2)
mb1$start
DMM0  <- Dmethod(d, Expr2, group = "Subject",  random = random2, verbose = 0,  method = "MM");DMM0
DMM1  <- Dmethod(d, Expr2, group = "Subject",  random = random2, verbose = 0,  method = "MM",  MM_base_obj = mb1);DMM1
DMM2  <- Dmethod(d, Expr2, group = "Subject",  random = random2, verbose = 0,  method = "MM",  MM_base_obj = mb2);DMM2
