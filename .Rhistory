oi0 <-nls(Expr_learn,data = qrt1,as.list(start_learn0),  algorithm = 'port')
Expr_learn  <- Y ~ ai1 - (ai1 + ai0) * exp(ai2 * t)
random_learn <- c("ai0~B0+B01*wm2+bi0", "ai1~B1+B11*wm2+bi1", "ai2 ~ B2 + B21*wm2 + bi2")
start_learn0  <- c(ai0 = 1, ai1 = 1, ai2 = 0.2)  # redefine via nls()
path <- "C:/Users/germu/OneDrive - Durham University/PhD/Rcodes/Rcodes and Data/Real Data Application/Shelley/qrt.xlsx"
# data
library(reshape2)#; library(readxl)
qrt  <-  data.frame(SkillAcq)#read_excel(file.path(path))
qrt1 <- melt(qrt, id.vars = c("id", "wm2"),
variable.name = "ly", value.name = "Y")
qrt1$t <- as.numeric(sub("ly", "", qrt1$ly))
oi0 <-nls(Expr_learn,data = qrt1,as.list(start_learn0),  algorithm = 'port')
start_learn <- coef(oi0)
##=========================== VLS ========================================================
#VLS variance: & Hypothesis testing H0: d00=d11=d22=0 when d00>0 and d11>0
DVLS_learn <- Dmethod(qrt1, Expr_learn, group = "id",method    = "VLS", random = random_learn, start = start_learn);#paper used unweighted GLS for beta
Tstat_UVlearn <-Tstat (DVLS_learn, bi_out = "bi2")
#nprem=200
HQ_VLS<- Dhypothesis_test( qrt1, Expr_learn, group = "id",  random = random_learn, start = start_learn, method = "VLS", nperm = 200, seed = 1, Dhatt = DVLS_learn  )
DVLS_learn
##=========================== MM ========================================================
#MM variance: & Hypothesis
MMB <- MM_base(qrt1, Expr_learn, group = "id", random =  random_learn, start = start_learn)# in the paper RR_catof = 10
DMM_learn  <- Dmethod (qrt1, Expr_learn, group = "id", random =  random_learn,method    = "MM", start = start_learn, MM_base_obj = MMB)# in the paper RR_catof = 10
summary(DMM_learn)
