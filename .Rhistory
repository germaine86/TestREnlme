library(TestREnlme)
d      <- as.data.frame(Theoph)
Expr   <- conc ~Dose * exp(ai2 + ai3 - ai1) * (exp(-Time * exp(ai3)) -  exp(-Time * exp(ai2)))/(exp(ai2) - exp(ai3))
start <- c(ai1 = -3.2, ai2 = 0.5, ai3 = -2.4)
random <- c("ai1 ~ B1 + bi1", "ai2 ~ B2 + bi2", "ai3 ~ B3 + bi3")
#Variance
DVLS <- Dmethod(d, Expr, group = "Subject", random = random, start = start, method = "VLS", verbose = 1)
summary(DVLS) # OK: all same as paper, except Beta, unweighted in the paper
